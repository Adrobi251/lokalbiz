# Secret HMAC JWT minimal 32 karakter; ganti sebelum menjalankan server.
AUTH_JWT_SECRET=replace-with-at-least-32-random-bytes
# Daftar origin aplikasi yang diizinkan, pisahkan dengan koma; tanpa path.
APP_ORIGINS=http://127.0.0.1:5173
DB_DRIVER=sqlite
DATABASE_PATH=./data/lokalbiz.sqlite
# Isi MYSQL_DATABASE dan MYSQL_USER saat DB_DRIVER=mysql. Password kosong valid untuk MySQL lokal XAMPP.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=lokalbiz_ai
PORT=3000
# Host lokal; deployment dapat mengatur HOST sesuai reverse proxy/platform.
HOST=127.0.0.1
# Jumlah hop proxy tepercaya untuk request.ip; biarkan 0 bila server menerima koneksi langsung.
TRUST_PROXY_HOPS=0
# Set true only after QA approves; all provider settings must be injected at runtime.
LOCAL_GEMINI_SUMMARY_ENABLED=false
LOCAL_GEMINI_ROUTER_BASE_URL=
LOCAL_GEMINI_ROUTER_MODEL=
LOCAL_GEMINI_ROUTER_API_KEY=
